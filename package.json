{
  "name": "morph",
  "version": "1.0.3",
  "description": "Morph - file converter",
  "author": "Or meir Tzarfati",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5174 && cross-env VITE_DEV=1 electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "vite build && electron-builder --win nsis --x64",
    "release": "vite build && electron-builder --win nsis --x64 --publish always",
    "fetch-bin": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/fetch-bin.ps1",
    "e2e:glass-menus": "vite build && electron e2e/glass-menus.cjs",
    "e2e:glass-pickers": "vite build && electron e2e/glass-pickers.cjs",
    "e2e:screenshots": "vite build && electron e2e/screenshots.cjs"
  },
  "repository": "github:OrMeirDev/Morph",
  "dependencies": {
    "electron-updater": "^6.8.9",
    "file-type": "^19.6.0",
    "heic-convert": "^2.1.0",
    "imagetracerjs": "^1.2.6",
    "pdf-lib": "^1.17.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.morph.converter",
    "productName": "Morph",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/sharp/**",
      "**/node_modules/@img/**"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin"
      },
      "THIRD_PARTY_NOTICES.md"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "OrMeirDev",
        "repo": "Morph",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Morph",
      "installerLanguages": [
        "he_IL"
      ],
      "language": "1037",
      "artifactName": "Morph-Setup-${version}.${ext}"
    }
  }
}
